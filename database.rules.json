{
  "rules": {
    "stats": {
      ".read": true,
      "plays": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "players": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "$other": { ".validate": false }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": ["score"],
      "$pid": {
        ".write": "$pid.length <= 64 && (!data.exists() || newData.child('score').val() >= data.child('score').val())",
        ".validate": "newData.hasChildren(['name', 'score', 'ts'])",
        "name":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
        "score": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999 && newData.val() % 1 === 0" },
        "ts":    { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
